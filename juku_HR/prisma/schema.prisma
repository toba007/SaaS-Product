// 塾HR - データモデル
// 注: SQLite は enum 非対応のため、区分値は String + lib/constants.ts の定数で表現する。
//     日付は timezone 事故を避けるため "YYYY-MM-DD" の String、時刻は "HH:MM" の String で持つ。

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- マスタ ----------

/// 塾ごとの設定。**塾によって違う数字をコードに埋めないための置き場所。**
/// 行は1つだけ持つ（id = 1 固定）。読むときは lib/settings.ts を通す。
model SchoolSetting {
  id Int @id @default(1)

  /// 個別指導で、講師1人が同時にみてよい生徒の上限。
  /// 「1対4まで」なら 4。給与の単価もこの数だけ（1対1〜1対4）持てるようになる。
  indivMaxStudents Int @default(2)

  /// 同時に使える集団教室の数。
  /// どの教室を使うかまでは決めない。「同時に何クラスまで立てられるか」の上限として使い、
  /// 実際に何室使うかは、その日その科目に出勤している講師の数で決まる。
  maxGroupRooms Int @default(1)

  /// 同時に使える個別ブースの数。考え方は maxGroupRooms と同じ。
  maxIndivRooms Int @default(1)

  updatedAt DateTime @updatedAt
}

/// 科目（英語・数学・国語・理科・社会 など）
model Subject {
  id    Int    @id @default(autoincrement())
  name  String @unique
  /// 表示順
  order Int    @default(0)

  lessons     Lesson[]
  teachers    TeacherSubject[]
  demands     ShiftDemand[]
  assignments ShiftAssignment[]
  students    StudentSubject[]
  classGroups ClassGroup[]
}

/// 教室（個別ブース・集団教室）
model Room {
  id       Int    @id @default(autoincrement())
  name     String @unique
  /// GROUP | INDIVIDUAL
  format   String
  /// 収容できる生徒数（個別ブースなら 2 など）
  capacity Int    @default(1)

  lessons       Lesson[]
  classSessions ClassSession[]
}

/// コマ（「小1限 17:40-18:20」「中2限 20:10-21:00」など）
///
/// **コマの区切り方は塾によってまったく違う。** コードに埋めず、塾ごとに登録してもらう。
/// 変わる軸は2つある。
///
/// - **期タイプ** — レギュラーは学校の後なので夕方から。講習は学校が無いので朝から、
///   コマ数も長さも変わる。特別授業（テスト対策など）も別枠で組まれる。
/// - **学年帯** — 小学生は17:40から40分、中学生は19:15から50分、のように
///   下校時刻と集中力に合わせて別の時間割になる塾が多い。
///
/// 学年で分けない塾もあるので、その場合は gradeBand = ALL の1組だけ登録する。
model Period {
  id        Int    @id @default(autoincrement())
  /// REGULAR | SUMMER | WINTER | SPRING | SPECIAL
  termKind  String @default("REGULAR")
  /// ALL(学年で分けない) | ELEM(小) | JUNIOR(中) | HIGH(高)
  gradeBand String @default("ALL")
  name      String
  startTime String
  endTime   String
  order     Int    @default(0)

  lessons       Lesson[]
  requests      ShiftRequest[]
  assignments   ShiftAssignment[]
  duties        DutyRecord[]
  demands          ShiftDemand[]
  classSessions       ClassSession[]
  studentSchedules    StudentSchedule[]
  timetablePlacements TimetablePlacement[]

  // 「夏期講習の1限」「小学生の1限」「中学生の1限」はどれも別のコマなので、
  // 名前だけでは一意にならない
  @@unique([termKind, gradeBand, name])
  @@index([termKind, gradeBand, order])
}

/// 講師
model Teacher {
  id           Int     @id @default(autoincrement())
  name         String
  kana         String  @default("")
  /// FULL_TIME(社員) | PART_TIME(時間講師) | STUDENT(学生講師)
  employment   String  @default("PART_TIME")
  email        String?
  phone        String?
  active       Boolean @default(true)
  /// 二次元コード打刻用。印刷して配るカードに入る。打刻しかできない。
  /// カードを配り直せるように、作り直せる前提で持つ。
  /// ログインは不要。教室に置いた端末やカードで打刻するため。
  punchToken   String  @unique @default(cuid())
  /// カレンダーアプリ（Googleカレンダー等）の購読URLに入れる秘密の値。
  /// これを知っている人は本人の予定を読めるので、実質パスワードとして扱う。
  /// 漏れたときに配り直せるよう、punchToken と同じく作り直せる前提で持つ。
  icsToken     String  @unique @default(cuid())

  // --- ログイン ---
  /// ログインID。管理者も講師も同じ入力欄から入る。
  loginId      String  @unique
  /// scrypt のハッシュ。"salt:hash" の形。平文は保存しない。
  passwordHash String
  /// ADMIN(管理者画面) | TEACHER(講師画面)
  /// 塾の社員は授業も持つので、講師レコードに役割を持たせている。
  role         String  @default("TEACHER")

  // --- 給与計算用（PDF: コマ給と時給の併用、交通費は定期あり/なしで別計算） ---
  /// 時給（事務作業に適用）円
  hourlyWage    Int @default(0)
  /// 交通費: 定期券あり期間の1日あたり支給額（通常は0）円
  commuteRegular Int @default(0)
  /// 交通費: 定期券なし期間（講習期間など）の1日あたり支給額 円
  commuteSpot    Int @default(0)

  subjects    TeacherSubject[]
  lessons     Lesson[]
  cards       AbsenceCard[]
  requests    ShiftRequest[]
  assignments ShiftAssignment[]
  punches     Punch[]
  duties      DutyRecord[]
  adminWorks  AdminWork[]
  messages    MessageRecipient[]
  wageRates   WageRate[]
  payRates    TeacherPayRate[]

  /// 自分についてのやりとり（管理者が書いたものも含む）
  shiftComments ShiftComment[] @relation("ShiftCommentTeacher")
  /// 自分が書いたやりとり
  sentComments  ShiftComment[] @relation("ShiftCommentSender")

  /// 勤務上限。未設定なら既定値を使う。
  shiftRule TeacherShiftRule?
}

/// 授業形態ごとのコマ給。
/// 同じ講師でも、集団を持つ日と個別を持つ日で単価が変わるため、講師×形態で持つ。
/// （PDF の事例「同じ講師でも指導内容で時給が変わる」に対応）
model WageRate {
  id        Int    @id @default(autoincrement())
  teacherId Int
  /// GROUP(集団) | INDIV_1(個別1対1) | INDIV_2(個別1対2)
  style     String
  /// 1コマあたりの金額（円）
  amount    Int    @default(0)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, style])
}

/// 講師が担当できる科目（時間割自動作成で使う科目適性）
model TeacherSubject {
  teacherId Int
  subjectId Int
  /// 1=可 2=得意 3=専門 (時間割最適化の優先度に使う)
  level     Int @default(1)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
}

/// 生徒
model Student {
  id     Int     @id @default(autoincrement())
  name   String
  kana   String  @default("")
  /// 小1..小6 / 中1..中3 / 高1..高3
  grade  String
  school String  @default("")
  active Boolean @default(true)

  attendances Attendance[]
  cards       AbsenceCard[]
  subjects    StudentSubject[]
  classes     ClassEnrollment[]
}

// ---------- 塾の予定 ----------

/// 塾の予定（休校日・行事）。管理者が入れ、講師側のカレンダーにも出る。
/// 期間で持つので、1日の予定も「休校週間」のような連続した予定も同じ形で入る。
model SchoolEvent {
  id    Int    @id @default(autoincrement())
  /// "YYYY-MM-DD"（1日だけなら startDate と endDate を同じにする）
  startDate String
  endDate   String
  title     String
  /// CLOSED(休校日・閉室) | EVENT(行事)
  /// CLOSED の日はシフト希望を出せない。無駄な入力と、休校日への割当事故を防ぐため。
  kind      String @default("EVENT")

  /// "HH:MM"。両方 null なら終日の予定。
  ///
  /// 終日と時間つきを別のテーブルに分けることもできるが、
  /// 「同じ日に終日の行事と、その中の打ち合わせ」が普通に並ぶので同じ表で扱う。
  /// 休校日(CLOSED)は必ず終日にする。isClosedDate() が日付だけで判定しており、
  /// 時間を持たせると「13時から休校」が1日ぜんぶ休校として効いてしまうため。
  startTime String?
  endTime   String?
  note      String @default("")

  /// 繰り返しで作った予定は、同じ値を共有する。
  ///
  /// 規則（毎週日曜など）を1件だけ保存する持ち方もあるが、
  /// 「この日だけ休校をやめる」が入った途端に例外の管理が要る。
  /// 塾の規模なら日付ぶんの行に展開したほうが単純で、
  /// isClosedDate() の判定も今までどおり日付の比較だけで済む。
  /// まとめて消したいときのために、どのまとまりで作られたかだけ覚えておく。
  seriesId  String?

  createdAt DateTime @default(now())

  @@index([startDate, endDate])
  @@index([seriesId])
}

// ---------- シフト ----------

/// 期（レギュラー / 夏期講習 / 冬期講習 / 春期講習）
/// 講習期間はコマの組み方も交通費の扱いも変わるので、期を明示的に持つ。
/// kind=REGULAR は定期券あり前提、講習は定期券なし前提で交通費を計算する。
model Term {
  id        Int    @id @default(autoincrement())
  name      String
  /// REGULAR | SUMMER | WINTER | SPRING
  kind      String @default("REGULAR")
  /// "YYYY-MM-DD"
  startDate String
  endDate   String

  requests      ShiftRequest[]
  assignments   ShiftAssignment[]
  timetableRuns TimetableRun[]

  @@index([startDate, endDate])
}

/// 講師が出したシフト希望（コマ単位）
/// 「集める人の忖度が入る」ことへの対策として、希望は講師本人が入れた記録として残す。
model ShiftRequest {
  id        Int    @id @default(autoincrement())
  teacherId Int
  /// "YYYY-MM-DD"
  date      String
  periodId  Int
  termId    Int?
  /// OK(出られる) | PREFER(できれば入りたい) | NG(出られない)
  status    String @default("OK")
  /// 「テスト前は避けたい」等、講師の一言
  note      String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  period  Period  @relation(fields: [periodId], references: [id])
  term    Term?   @relation(fields: [termId], references: [id])

  @@unique([teacherId, date, periodId])
  @@index([date])
}

/// 確定したシフト（この講師はこの日のこのコマに入る）
/// 実際にどの生徒・どのブースを見るか（Lesson）はこの後の工程で決める。
model ShiftAssignment {
  id        Int    @id @default(autoincrement())
  teacherId Int
  date      String
  periodId  Int
  termId    Int?
  note      String @default("")

  /// どのシフト計画で作られたか。既存データがあるので null 可。
  planId    Int?
  /// 担当する科目。どの需要を埋めた割当かを表す。
  /// これが無いと「人数は足りているが、その科目を教えられる人がいない」を検出できない。
  /// 既存データがあるので null 可だが、自動作成では必ず入る。
  subjectId Int?
  /// GROUP | INDIV_1 | INDIV_2。給与のコマ給単価に直結する。
  format    String?
  /// AUTO(自動作成) | MANUAL(手修正)
  source    String  @default("MANUAL")
  /// true なら自動作成をやり直しても動かさない。
  /// これが無いと「手直し→再実行→手直しが消える」となり、実質1回しか回せない。
  locked    Boolean @default(false)
  /// 割当時の評価値。「なぜこの人か」の根拠として残す。
  score     Float?

  createdAt DateTime @default(now())

  teacher Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  period  Period     @relation(fields: [periodId], references: [id])
  term    Term?      @relation(fields: [termId], references: [id])
  plan    ShiftPlan? @relation(fields: [planId], references: [id])
  subject Subject?   @relation(fields: [subjectId], references: [id])

  // 同じ講師が同じコマで2科目を持てないことを、DB のレベルで保証する（H13）
  @@unique([teacherId, date, periodId])
  @@index([date])
  @@index([planId])
}

// ---------- 勤怠 ----------
// 学習塾特有の勤務形態にあわせる:
//   - 1日に複数回の出退勤がある（Punch を1日に何本でも作れる）
//   - 給与は「何コマ担当したか」で決まる部分がある（DutyRecord）
//   - 授業以外に事務作業の時間がある（AdminWork）
// ShiftAssignment は「予定」、ここにあるのは「実績」。当日の交代があるので別に持つ。

/// 打刻（1回の出勤〜退勤）。1日に複数本ありうる。
model Punch {
  id        Int     @id @default(autoincrement())
  teacherId Int
  /// "YYYY-MM-DD"
  date      String
  /// "HH:MM"
  inAt      String
  /// 退勤前は null
  outAt     String?
  note      String  @default("")

  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, date])
  @@index([date])
}

/// その日に実際に担当したコマ（コマ給の計算根拠）
/// コマ給は授業形態で変わるので、何を担当したかまで記録しないと給与が出せない。
model DutyRecord {
  id        Int    @id @default(autoincrement())
  teacherId Int
  date      String
  periodId  Int
  /// GROUP(集団) | INDIV_1(個別1対1) | INDIV_2(個別1対2)
  /// 旧方式。給与は payItemId で決まる。移行前の実績を拾うために残している。
  style     String @default("GROUP")
  /// どの賃金項目として払うか。未設定なら style から引く。
  payItemId Int?

  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  period  Period   @relation(fields: [periodId], references: [id])
  payItem PayItem? @relation(fields: [payItemId], references: [id])

  @@unique([teacherId, date, periodId])
  @@index([date])
}

/// 事務作業（時給の計算根拠）
model AdminWork {
  id        Int    @id @default(autoincrement())
  teacherId Int
  date      String
  /// 何分やったか
  minutes   Int
  note      String @default("")
  /// どの賃金項目として払うか。未設定なら「事務作業」の項目に入る。
  payItemId Int?

  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  payItem PayItem? @relation(fields: [payItemId], references: [id])

  @@index([teacherId, date])
  @@index([date])
}

// ---------- 講師連絡 ----------

/// 講師への連絡・アンケート
model Message {
  id    Int    @id @default(autoincrement())
  title String
  body  String
  /// NOTICE(連絡) | SURVEY(アンケート)
  kind  String @default("NOTICE")
  /// アンケートの選択肢。1行1つ。空なら自由記述。
  options String @default("")

  createdAt DateTime @default(now())

  recipients MessageRecipient[]
}

/// 誰に送ったか・読んだか・答えたか
model MessageRecipient {
  id        Int       @id @default(autoincrement())
  messageId Int
  teacherId Int
  readAt    DateTime?
  /// アンケートの回答
  answer    String?
  answeredAt DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([messageId, teacherId])
  @@index([teacherId])
}

// ---------- 授業 ----------

/// 授業（1コマ・1教室・1講師ぶんの枠）
model Lesson {
  id        Int    @id @default(autoincrement())
  /// "YYYY-MM-DD"
  date      String
  /// GROUP(集団) | INDIVIDUAL(個別)
  format    String
  /// 集団のクラス名など。個別は空でよい
  title     String @default("")

  periodId  Int
  subjectId Int
  teacherId Int
  roomId    Int

  period  Period  @relation(fields: [periodId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  record      LessonRecord?
  attendances Attendance[]
  cards       AbsenceCard[]

  createdAt DateTime @default(now())

  @@index([date])
  @@index([date, periodId])
}

/// 授業記録（進んだ内容・宿題）
/// 集団授業では欠席者全員に共通の内容になるため、授業に対して1回だけ書けばよい。
/// これが欠席者カードの下書きになる。
model LessonRecord {
  id        Int      @id @default(autoincrement())
  lessonId  Int      @unique
  /// 授業で進んだ内容
  progress  String   @default("")
  /// 宿題
  homework  String   @default("")
  /// 塾内向けの申し送り（カードには載せない）
  note      String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

/// 出欠
model Attendance {
  id        Int    @id @default(autoincrement())
  lessonId  Int
  studentId Int
  /// PRESENT(出席) | ABSENT(欠席) | LATE(遅刻) | MAKEUP(振替)
  status    String @default("PRESENT")

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

/// 欠席者カード
/// 進んだ内容・宿題は LessonRecord から複製して作るが、個別指導では生徒ごとに
/// 中身が変わるため、カード側で上書きできるようにしている。
/// カードは「実際に渡した紙の控え」に相当するので、渡した時点の内容を保持する。
model AbsenceCard {
  id        Int    @id @default(autoincrement())
  lessonId  Int
  studentId Int
  /// カードに印字する担当講師（通常は lesson.teacher と同じ）
  teacherId Int

  progress String @default("")
  homework String @default("")
  /// その生徒だけへのひとこと
  comment  String @default("")

  /// DRAFT(下書き) | READY(渡す準備OK) | DELIVERED(受渡済)
  status      String    @default("DRAFT")
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([lessonId, studentId])
  @@index([status])
  @@index([studentId, status])
}

// ---------- その日についてのやりとり ----------

/// 講師と教室が、ある日について交わす短いやりとり。
///
/// シフト提出のカレンダーと、確定シフト・時間割のカレンダーは別画面だが、
/// スレッドは「講師 × 日付」で1本にする。提出時の「この日は厳しいです」と
/// 確定後の「代講お願いできますか」は同じ日の話なので、分けると講師も管理者も
/// 2箇所を見に行くことになり、片方が見落とされる。
///
/// ShiftRequest.note / ShiftAssignment.note の役割はこちらが引き継ぐ。
/// 一言では返事ができず、言った言わないになるため。
/// （旧 note カラムは既存データを壊さないよう残してあるが、画面からは使わない）
model ShiftComment {
  id        Int    @id @default(autoincrement())
  /// 誰との会話か。管理者が書いたものでも、相手の講師を指す。
  teacherId Int
  /// "YYYY-MM-DD"
  date      String
  /// ADMIN | TEACHER
  senderRole String
  /// 書いた本人。管理者は複数いるので、誰が言ったのかを残す。
  /// 講師が書いた場合は teacherId と同じ値になる。
  senderId  Int
  body      String

  createdAt DateTime  @default(now())
  /// 相手が読んだ時刻。未読バッジに使う。
  readAt    DateTime?

  teacher Teacher @relation("ShiftCommentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  sender  Teacher @relation("ShiftCommentSender", fields: [senderId], references: [id])

  // スレッドを開くたびに引くので、この順で持つ
  @@index([teacherId, date])
}

// ---------- 賃金項目 ----------

/// 賃金の項目。コマ給・時給・交通費などを管理者が自由に作れるようにしたもの。
/// 決め打ちなのは「何に掛けるか」（basis）だけ。
model PayItem {
  id     Int    @id @default(autoincrement())
  name   String
  /// PER_SLOT(コマ数×単価) | PER_HOUR(時間×単価) | PER_DAY(日数×単価) | MONTHLY(月額固定)
  basis  String @default("PER_SLOT")
  /// 数量の取り方。basis によって意味が変わる。
  ///   PER_DAY  : REGULAR(定期券あり期間) | SPOT(定期券なし期間)
  ///   PER_SLOT : 空。実績（DutyRecord）側が payItemId でこの項目を指す
  ///   PER_HOUR : 空。実績（AdminWork）側が payItemId でこの項目を指す
  ///   MONTHLY  : 空。単価が入っている講師に毎月そのまま付く
  source String @default("")
  /// 移行用。旧 style 値（GROUP / INDIV_1 / INDIV_2）との対応。
  /// payItemId が入っていない古い実績を、この値で拾う。
  legacyStyle String?
  order  Int     @default(0)
  /// 使わなくなった項目。過去の明細のために消さずに残す。
  active Boolean @default(true)

  rates      TeacherPayRate[]
  duties     DutyRecord[]
  adminWorks AdminWork[]

  @@index([active, order])
}

/// 講師ごとの単価。項目 × 講師で持つ。
model TeacherPayRate {
  teacherId Int
  payItemId Int
  /// 単価（円）。PER_SLOT なら1コマ、PER_HOUR なら1時間、PER_DAY なら1日、MONTHLY なら月額。
  amount    Int @default(0)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  payItem PayItem @relation(fields: [payItemId], references: [id], onDelete: Cascade)

  @@id([teacherId, payItemId])
  @@index([payItemId])
}

// ---------- 開講時間割 ----------

/// 時間割を組んだ1回ぶんの記録。
///
/// ---- なぜ記録として残すのか ----
/// ローカルの LLM に頼むと実測で18分かかる。ボタンを押して待たせると
/// ブラウザが固まるので、**始めたら記録を作って戻り、結果は後から見る**。
/// 進行中かどうか、何分かかったか、AI がどれだけ決めたかもここに残す。
///
/// ---- 提案であって、確定ではない ----
/// ここに入るのは案。人が見て手直しして、確定したときに初めて
/// ClassSession（集団）と StudentSchedule（個別）へ書き込む。
model TimetableRun {
  id     Int @id @default(autoincrement())
  termId Int

  /// RUNNING(実行中) | DONE(終わった) | FAILED(失敗)
  status String @default("RUNNING")
  /// AI(LLMに提案させた) | GREEDY(AIを使わない配置)
  mode   String @default("GREEDY")

  /// 管理者が日本語で書いた要望。AI のときだけ使う
  note String @default("")

  /// 実際に答えたモデル名。結果を人が確認するときに出す
  model     String @default("")
  elapsedMs Int    @default(0)
  /// AI の提案として通った数
  fromAi       Int @default(0)
  /// 決定的な配置で埋めた数。**ここが多いほど AI は役に立っていない**
  fromFallback Int @default(0)
  /// 検証で落とした提案の数
  rejected     Int @default(0)

  /// 置けなかった対象と理由。JSON文字列で持つ（SQLite に型が無いため）
  unplaced String @default("")
  /// 失敗したときの理由
  error    String @default("")

  /// 確定して ClassSession / StudentSchedule に書き込んだ日時
  appliedAt DateTime?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  term       Term                 @relation(fields: [termId], references: [id], onDelete: Cascade)
  placements TimetablePlacement[]

  @@index([termId, startedAt])
}

/// 提案された1コマぶんの配置。
model TimetablePlacement {
  id    Int @id @default(autoincrement())
  runId Int

  /// "class:3" / "indiv:12"。対象を指す
  targetKey String
  /// CLASS(集団) | INDIV(個別)
  kind      String
  /// ClassGroup.id または StudentSubject.id
  refId     Int
  /// 画面に出す名前。実行時点の名前を焼き付ける（後で改名されても記録が読める）
  label     String

  /// 0=日 .. 6=土
  dayOfWeek Int
  periodId  Int

  /// AI が付けた理由。「なぜこの枠か」を画面に出す
  reason String @default("")
  /// 人が後から足した配置か（AI の提案と区別する）
  byHand Boolean @default(false)

  run    TimetableRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  period Period       @relation(fields: [periodId], references: [id])

  @@index([runId, dayOfWeek, periodId])
}

// ---------- シフト計画 ----------

/// シフト計画。対象期間ごとに1つ作る。
///
/// 「確定前と確定後を区別する」（全体要件）を満たすための入れ物。
/// 検討中のシフトが講師に見えてしまうと、確定していない予定で人が動く。
model ShiftPlan {
  id        Int    @id @default(autoincrement())
  name      String
  /// "YYYY-MM-DD"
  fromDate  String
  toDate    String
  /// DRAFT(下書き) | CONFIRMED(確定)
  /// 講師に見せるのは CONFIRMED だけ。
  status    String @default("DRAFT")

  /// 自動作成の重み。JSON文字列で持つ（区分値と同じく、SQLite に型が無いため）
  weights     String    @default("")
  /// 最後の実行結果サマリ。JSON文字列。
  lastResult  String    @default("")
  generatedAt DateTime?
  confirmedAt DateTime?
  /// 誰が確定したか
  confirmedById Int?

  // --- 確定解除 ---
  // 確定したシフトを後から変えるには、いったん解除する必要がある。
  // 黙って変えられると、講師が見た予定と実際がずれる。
  // 「誰が・いつ・なぜ」を残す（全体要件の「変更履歴」の最小版。
  //  1件ずつの変更履歴 ShiftChangeLog は次の版）。
  reopenedAt   DateTime?
  reopenedById Int?
  reopenReason String    @default("")

  createdAt DateTime @default(now())

  assignments ShiftAssignment[]
  demands     ShiftDemand[]

  @@index([fromDate, toDate])
}

/// そのコマに、どの科目の講師が何人必要か。自動作成のゴール。
///
/// 「講師4人」ではなく「英語2人・数学1人」で持つ。
/// 科目を見ずに人数だけ合わせると、誰も英語を教えられないシフトが
/// 「正常」として確定できてしまう。
model ShiftDemand {
  id        Int    @id @default(autoincrement())
  planId    Int
  /// "YYYY-MM-DD"
  date      String
  periodId  Int
  subjectId Int
  /// GROUP | INDIV_1 | INDIV_2
  format    String @default("INDIV_2")
  /// 必要な講師数。0 なら授業を開かない。
  required  Int    @default(0)
  /// 根拠になった生徒数。「なぜ2人必要か」を画面に出すために持つ。
  studentCount Int @default(0)
  note      String @default("")

  plan    ShiftPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  period  Period    @relation(fields: [periodId], references: [id])
  subject Subject   @relation(fields: [subjectId], references: [id])

  @@unique([planId, date, periodId, subjectId, format])
  @@index([date])
}

/// 講師ごとの勤務上限。未設定の講師には既定値を使う。
///
/// これが無いと、公平性だけを見て1人に詰め込む解が出る。
/// 既定値は仮置きで、労働時間のルールとあわせて塾に確認が要る。
model TeacherShiftRule {
  teacherId      Int @id
  /// 1日あたりの上限コマ数
  maxPerDay      Int @default(4)
  /// 1週(日〜土)あたりの上限コマ数
  maxPerWeek     Int @default(12)
  /// 連続して入れる上限コマ数（休憩が取れなくなるため）
  maxConsecutive Int @default(3)
  /// 1週あたりの下限コマ数。0 なら下限なし。
  minPerWeek     Int @default(0)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

// ---------- 生徒の受講 ----------

/// 生徒が取っている科目。入塾のときに「何を取るか」を聞いて登録する。
///
/// ここが埋まっていないと、集団のクラス分けで「誰を振り分けるのか」が分からない。
/// 同じ科目を集団と個別の両方で取ることもある（集団で受けつつ、苦手なので個別も）
/// ので、形態まで含めて1行にする。
model StudentSubject {
  id        Int     @id @default(autoincrement())
  studentId Int
  subjectId Int
  /// GROUP(集団) | INDIV_1(個別1対1) | INDIV_2(個別1対2) | ... 上限は塾の設定で決まる
  format    String

  /// **週に何コマ受けるか。** 生徒に聞いて決める「量」。
  ///
  /// 集団はクラスの時間割（ClassSession）が決めるので使わない。
  /// 個別はここが起点になる：週2コマと決まって初めて、どの枠に入れるかを決められる。
  /// 0 のままだと配置のしようが無いので、画面で不備として知らせる。
  slotsPerWeek Int @default(0)

  /// 途中でやめた科目は false にする。行を消すと過去の授業と辻褄が合わなくなる。
  active    Boolean @default(true)

  createdAt DateTime @default(now())

  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject           @relation(fields: [subjectId], references: [id])
  schedules StudentSchedule[]

  @@unique([studentId, subjectId, format])
  @@index([subjectId, format])
}

/// 個別指導の配置。「田中さんは毎週火曜2限に英語」
///
/// ---- 集団の ClassSession と同じ役割 ----
/// 集団はクラスに時間割が付く。個別は生徒に付く。どちらも「いつやるか」を持つ。
///
/// ---- これは入力ではなく、決めた結果 ----
/// 生徒に「週に何コマ受けたいか」を聞き（StudentSubject.slotsPerWeek）、
/// **担当できる講師がいつ来られるかを見て**、この行が決まる。
/// 決めたら生徒に「火曜2限に来てください」と伝える。
///
/// ---- レギュラーと講習で単位が違う ----
/// レギュラーは1週間周期で回るので曜日（dayOfWeek）で持つ。
/// 講習は日ごとに違うので日付（date）で持つ。**どちらか一方だけを入れる。**
/// 単位を切り替えられるようにしておかないと、講習で作り直しになる。
model StudentSchedule {
  id               Int     @id @default(autoincrement())
  studentSubjectId Int

  /// 0=日 .. 6=土。レギュラー用。日付で持つときは null。
  dayOfWeek Int?
  /// "YYYY-MM-DD"。講習用。曜日で持つときは null。
  date      String?
  periodId  Int

  /// 有効期間 "YYYY-MM-DD"。学期ごとに組み直すので日付の範囲で持つ
  /// （ClassGroup と同じ考え方）。date で持つ行では date と同じ値を入れる。
  fromDate String
  toDate   String

  createdAt DateTime @default(now())

  studentSubject StudentSubject @relation(fields: [studentSubjectId], references: [id], onDelete: Cascade)
  period         Period         @relation(fields: [periodId], references: [id])

  @@index([dayOfWeek, periodId])
  @@index([date, periodId])
  @@index([fromDate, toDate])
}

/// 集団クラス。学年 × 科目 × レベル で立てる。
///
/// **レベルは Ⅰ〜Ⅲ だが、必ず3クラスあるわけではない。**
/// 人数によって2クラスのことも、1クラスだけのこともある。
/// レベルは「枠」ではなく、実際に立ったクラスに付くラベルとして扱う。
///
/// 組み直しは「人数が増えたとき・学期が変わるとき・学年が変わるとき」に
/// 臨機応変に行うので、期（Term）ではなく日付の範囲で有効期間を持つ。
/// 分割するときは新しいクラスを作り、古いほうの toDate を切る。
///
/// **時間割はクラスが直接持たない（ClassSession に分けてある）。**
/// 「月曜は中1Ⅰが英英数」のように、同じクラスが同じ日に何コマも入るため。
/// 曜日とコマをここに1つずつ持たせると、それが表現できない。
///
/// 個別と違って、生徒が何人いても講師は1人。
model ClassGroup {
  id        Int    @id @default(autoincrement())
  /// 表示名。"中2英語Ⅱ" のように人が読む形で持つ。
  name      String
  /// 小1..小6 / 中1..中3 / 高1..高3
  grade     String
  subjectId Int
  /// 1..3（Ⅰ Ⅱ Ⅲ）。1クラスしか無いときは 1 を使う。
  level     Int    @default(1)

  /// **週に何コマ開講するか。** 塾が先に決める数。
  ///
  /// 「中3Ⅰの数学は週3コマ、国語は週1コマ」のように科目とレベルで違う。
  /// 個別の StudentSubject.slotsPerWeek と同じ位置づけで、
  /// **時間割を組む前に決まっている「量」**。ここから配置の数が決まる。
  ///
  /// 既存の時間割（ClassSession）から数えるのではないことに注意。
  /// まだ時間割が無い状態でも組めるようにするため、宣言として持つ。
  ///
  /// **0 は「その期は開講しない」。** クラスは残したまま時間割から外せる。
  /// 行を消すと在籍と過去の授業の辻褄が合わなくなるので、消さずに 0 にする。
  slotsPerWeek Int @default(1)

  /// 定員。0 なら上限なし。超えたら画面で警告する（保存は止めない）。
  capacity  Int    @default(0)

  /// 有効期間 "YYYY-MM-DD"
  fromDate  String
  toDate    String

  createdAt DateTime @default(now())

  subject  Subject @relation(fields: [subjectId], references: [id])
  members  ClassEnrollment[]
  sessions ClassSession[]

  @@index([grade, subjectId])
  @@index([fromDate, toDate])
}

/// クラスの時間割。毎週このローテーションで回る。
///
/// 「月曜は中1Ⅰが英英数、Ⅱが数数英」のような組み方をするので、
/// 1つのクラスが同じ日に複数コマ入る。だからクラスとは別の行にする。
///
/// 毎週同じなので日付ではなく曜日で持ち、実際の日付には展開して使う。
/// 週によって変わる場合は、クラスを組み直す（有効期間を切って新しく作る）。
model ClassSession {
  id           Int @id @default(autoincrement())
  classGroupId Int
  /// 0=日 .. 6=土
  dayOfWeek    Int
  periodId     Int
  roomId       Int?

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  period     Period     @relation(fields: [periodId], references: [id])
  room       Room?      @relation(fields: [roomId], references: [id])

  // 同じクラスが同じ曜日の同じコマに2回入ることはない
  @@unique([classGroupId, dayOfWeek, periodId])
  @@index([dayOfWeek, periodId])
}

/// 誰がどのクラスにいるか。
/// 振り分けは人が決める（成績から自動で決めない）。
model ClassEnrollment {
  classGroupId Int
  studentId    Int

  createdAt DateTime @default(now())

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classGroupId, studentId])
  @@index([studentId])
}
